#!/bin/sh
# From upstream's kvmd.install (post_upgrade), minus the PiKVM OS migrations.
set -e
if [ "$1" = configure ]; then
	systemd-sysusers /usr/lib/sysusers.d/kvmd.conf
	# https://github.com/systemd/systemd/issues/13522
	for user in $(awk '$1 == "u" {print $2}' /usr/lib/sysusers.d/kvmd.conf); do
		usermod --expiredate= "$user" >/dev/null 2>&1 || true
	done
	chown kvmd:kvmd /etc/kvmd/htpasswd /etc/kvmd/totp.secret || true
	chown kvmd-ipmi:kvmd-ipmi /etc/kvmd/ipmipasswd || true
	chown kvmd-vnc:kvmd-vnc /etc/kvmd/vncpasswd || true
	chmod 600 /etc/kvmd/*passwd || true
	chown kvmd /var/lib/kvmd/msd || true
	chown kvmd-pst:kvmd-pst /var/lib/kvmd/pst || true
	chmod 1775 /var/lib/kvmd/pst || true
	[ -e /etc/kvmd/nginx/ssl/server.crt ] || kvmd-gencert --do-the-thing
	[ -e /etc/kvmd/vnc/ssl/server.crt ] || kvmd-gencert --do-the-thing --vnc
	for target in nginx vnc; do
		chown root:root "/etc/kvmd/$target/ssl" || true
		for f in server.key:440 server.crt:444; do
			path="/etc/kvmd/$target/ssl/${f%%:*}"
			if [ ! -L "$path" ]; then
				chown "root:kvmd-$target" "$path" || true
				chmod "${f##*:}" "$path" || true
			fi
		done
	done
fi
#DEBHELPER#
exit 0
