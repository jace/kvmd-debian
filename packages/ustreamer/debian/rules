#!/usr/bin/make -f
# uStreamer with systemd support only: HackFo's TC358743 needs no GPIO, DRM pass-through or Janus.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export PYBUILD_NAME = ustreamer
# setup.py turns MK_WITH_* variables into its feature list
export MK_WITH_SYSTEMD = 1
FEATURES = WITH_SYSTEMD=1

%:
	dh $@ --with python3

override_dh_auto_build:
	$(MAKE) $(FEATURES) CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)"
	dh_auto_build --buildsystem=pybuild --sourcedirectory=python

override_dh_auto_install:
	$(MAKE) $(FEATURES) PREFIX=/usr DESTDIR=$(CURDIR)/debian/ustreamer install
	dh_auto_install --buildsystem=pybuild --sourcedirectory=python --destdir=debian/python3-ustreamer

override_dh_auto_test:

override_dh_auto_clean:
	$(MAKE) clean || true
	dh_auto_clean --buildsystem=pybuild --sourcedirectory=python
